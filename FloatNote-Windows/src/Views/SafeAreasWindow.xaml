<Window x:Class="FloatNote.Views.SafeAreasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Безопасные зоны"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Grid Background="#01000000">
        <!-- Close / Lock Controls at top right -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24">
            <Button x:Name="LockBtn" Click="Lock_Click" Content="🔒 Lock Click" Padding="8,4" Background="#33FFFFFF" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Click="Close_Click" Content="✕" Width="28" Height="28" Background="#33FFFFFF" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- 9:16 Vertical Video Overlay Guide in Center -->
        <Border Width="360" Height="640" BorderBrush="#8800FFCC" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <!-- Top UI Safe Area -->
                <Border Height="80" VerticalAlignment="Top" Background="#1500FFCC" BorderBrush="#5500FFCC" BorderThickness="0,0,0,1">
                    <TextBlock Text="Верхняя зона соцсетей (UI / Поиск)" Foreground="#AA00FFCC" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- Bottom UI Safe Area -->
                <Border Height="140" VerticalAlignment="Bottom" Background="#1500FFCC" BorderBrush="#5500FFCC" BorderThickness="0,1,0,0">
                    <TextBlock Text="Нижняя зона (Титры / Описание)" Foreground="#AA00FFCC" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- Center Target -->
                <TextBlock Text="9:16 Action Safe" Foreground="#5500FFCC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
