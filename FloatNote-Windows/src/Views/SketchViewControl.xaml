<UserControl x:Class="FloatNote.Views.SketchViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/> <!-- Tools Bar -->
            <RowDefinition Height="*"/>  <!-- Canvas Area -->
        </Grid.RowDefinitions>

        <!-- Compact PowerToys Style Sketch Toolbar -->
        <Border Grid.Row="0" Background="#18FFFFFF" CornerRadius="6" Margin="4,0,4,4" Padding="4">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="ToolPen_Click" Content="✏" Width="26" Height="24" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Карандаш"/>
                    <Button Click="ToolArrow_Click" Content="➔" Width="26" Height="24" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Стрелка" Margin="4,0,0,0"/>
                    <Button Click="ToolRect_Click" Content="▭" Width="26" Height="24" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Прямоугольник" Margin="4,0,0,0"/>
                    <Button Click="ColorRed_Click" Width="14" Height="14" Background="#FF3B30" Margin="10,0,4,0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                    </Button>
                    <Button Click="ColorGreen_Click" Width="14" Height="14" Background="{StaticResource AccentGreenBrush}" Margin="2,0,4,0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                    </Button>
                    <Button Click="ColorCyan_Click" Width="14" Height="14" Background="#00FFFF" Margin="2,0,4,0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="Clear_Click" Content="🗑" Width="26" Height="24" Background="Transparent" Foreground="#FF453A" BorderThickness="0" Cursor="Hand" ToolTip="Очистить холст"/>
                    <Button Click="SavePng_Click" Content="💾 PNG" Padding="8,2" Background="#28FFFFFF" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Сохранить эскиз" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Ink Canvas for drawing -->
        <Border Grid.Row="1" Background="#10000000" CornerRadius="6" Margin="4">
            <InkCanvas x:Name="SketchInkCanvas" Background="Transparent">
                <InkCanvas.DefaultDrawingAttributes>
                    <DrawingAttributes Color="#FF3B30" Width="3" Height="3" FitToCurve="True"/>
                </InkCanvas.DefaultDrawingAttributes>
            </InkCanvas>
        </Border>
    </Grid>
</UserControl>
