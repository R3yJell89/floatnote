<Window x:Class="FloatNote.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FloatNote"
        Height="500" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual">

    <!-- Outer Acrylic Border with Windows 11 Rounded Corners -->
    <Border Background="{StaticResource AcrylicBackgroundBrush}"
            BorderBrush="{StaticResource SubtleBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/> <!-- Title Bar -->
                <RowDefinition Height="38"/> <!-- Pill Navigation Tabs -->
                <RowDefinition Height="*"/>  <!-- Active Tab Content -->
                <RowDefinition Height="46"/> <!-- Bottom Input / Action Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar (Draggable) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pin (Always on Top) & App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="PinButton" Click="PinButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Закрепить поверх всех окон (Pin)">
                        <TextBlock Text="📌" FontSize="12" Foreground="{StaticResource AccentGreenBrush}"/>
                    </Button>
                    <TextBlock Text="FloatNote" 
                               FontFamily="{StaticResource SegoeUIVariable}" 
                               FontWeight="SemiBold" 
                               FontSize="13" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               Margin="8,0,0,0" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Settings, Minimize & Close Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Click="OpenSettings_Click" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Настройки" Content="⚙"/>
                    <Button Click="Minimize_Click" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Свернуть" Content="—"/>
                    <Button Click="Close_Click" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Закрыть" Content="✕"/>
                </StackPanel>
            </Grid>

            <!-- 2. PowerToys Style Pill Navigation Tabs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <RadioButton x:Name="TabChecklist" Content="Чеклист" Style="{StaticResource PillTabButtonStyle}" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabNotes" Content="Заметки" Style="{StaticResource PillTabButtonStyle}" Margin="6,0,0,0" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabAudio" Content="Аудио" Style="{StaticResource PillTabButtonStyle}" Margin="6,0,0,0" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabSketch" Content="Скетч" Style="{StaticResource PillTabButtonStyle}" Margin="6,0,0,0" Checked="Tab_Checked"/>
            </StackPanel>

            <!-- 3. Dynamic Tab Content -->
            <Grid Grid.Row="2" Margin="12,4,12,4">
                <!-- Checklist View: Lightweight Minimalist Layout -->
                <ScrollViewer x:Name="ChecklistScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChecklistItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource SubtleBorderBrush}" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="6,8" 
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                            <ColumnDefinition Width="*"/>    <!-- Task Title -->
                                            <ColumnDefinition Width="Auto"/> <!-- Subtle Timecode Badge -->
                                            <ColumnDefinition Width="Auto"/> <!-- Pin Marker Button -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Round Checkbox -->
                                        <CheckBox Grid.Column="0" 
                                                  IsChecked="{Binding IsCompleted}" 
                                                  VerticalAlignment="Center" 
                                                  Margin="0,0,8,0"
                                                  Checked="TaskCheck_Changed" 
                                                  Unchecked="TaskCheck_Changed"/>

                                        <!-- Title -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Title}" 
                                                   FontFamily="{StaticResource SegoeUIVariable}" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Minimal subtle timecode (right aligned) -->
                                        <Button Grid.Column="2" 
                                                Content="{Binding Timecode}" 
                                                Click="Timecode_Click"
                                                Visibility="{Binding Timecode, Converter={StaticResource StringToVisibilityConverter}}"
                                                Background="Transparent" 
                                                BorderThickness="0"
                                                Foreground="{StaticResource TextSecondaryBrush}" 
                                                FontFamily="Consolas, monospace" 
                                                FontSize="11" 
                                                Cursor="Hand"
                                                Margin="6,0" 
                                                ToolTip="Перейти к таймкоду на таймлайне"/>

                                        <!-- Push Marker Pin Button -->
                                        <Button Grid.Column="3" 
                                                Click="AddMarker_Click" 
                                                Background="Transparent" 
                                                BorderThickness="0"
                                                Foreground="{StaticResource AccentGreenBrush}" 
                                                FontSize="11" 
                                                Cursor="Hand" 
                                                ToolTip="Поставить маркер на таймлайн DaVinci"
                                                Content="📍"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Notes View -->
                <TextBox x:Name="NotesTextBox" 
                         Visibility="Collapsed" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap"
                         Background="Transparent" 
                         BorderThickness="0" 
                         Foreground="{StaticResource TextPrimaryBrush}" 
                         FontFamily="{StaticResource SegoeUIVariable}" 
                         FontSize="12" 
                         TextChanged="NotesTextBox_TextChanged"/>
            </Grid>

            <!-- 4. Bottom Input Bar -->
            <Border Grid.Row="3" Background="#14FFFFFF" CornerRadius="0,0,10,10" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NewTaskInput" 
                             KeyDown="NewTaskInput_KeyDown"
                             Background="Transparent" 
                             BorderThickness="0" 
                             Foreground="{StaticResource TextPrimaryBrush}" 
                             FontFamily="{StaticResource SegoeUIVariable}" 
                             FontSize="12" 
                             VerticalAlignment="Center"/>

                    <TextBlock Text="Новая задача с таймкодом... (Enter)" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               IsHitTestVisible="False" 
                               VerticalAlignment="Center" 
                               Visibility="{Binding Text.IsEmpty, ElementName=NewTaskInput, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Grid.Column="1" Click="AddTaskButton_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentGreenBrush}" FontSize="16" Content="➕" Cursor="Hand" Margin="6,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
