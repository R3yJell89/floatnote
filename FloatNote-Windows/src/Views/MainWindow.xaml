<Window x:Class="FloatNote.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FloatNote.Views"
        Title="FloatNote"
        Height="500" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual">

    <Border Background="{StaticResource AcrylicBackgroundBrush}"
            BorderBrush="{StaticResource SubtleBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/> <!-- Title Bar -->
                <RowDefinition Height="38"/> <!-- Navigation Tabs -->
                <RowDefinition Height="*"/>  <!-- Active Tab Content -->
                <RowDefinition Height="Auto"/> <!-- Bottom Input Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="PinButton" Click="PinButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Закрепить (Always on Top)">
                        <TextBlock Text="📌" FontSize="12" Foreground="{StaticResource AccentGreenBrush}"/>
                    </Button>
                    <TextBlock Text="FloatNote" FontFamily="{StaticResource SegoeUIVariable}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Action Tools -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Click="ToggleTimer_Click" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Таймер монтажа &amp; Помодоро" Content="⏱"/>
                    <Button Click="ToggleClipboard_Click" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="История буфера" Content="📋"/>
                    <Button Click="ToggleSafeAreas_Click" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Безопасные зоны 9:16 (Esc для закрытия)" Content="📐"/>
                    <Button Click="ToggleReference_Click" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Референс HUD" Content="🖼"/>
                    <Button Click="OpenSettings_Click" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Настройки" Content="⚙"/>
                    <Button Click="Minimize_Click" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Свернуть" Content="—"/>
                    <Button Click="Close_Click" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Закрыть" Content="✕"/>
                </StackPanel>
            </Grid>

            <!-- 2. Pill Tabs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <RadioButton x:Name="TabChecklist" Content="Чеклист" Style="{StaticResource PillTabButtonStyle}" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabNotes" Content="Заметки" Style="{StaticResource PillTabButtonStyle}" Margin="6,0,0,0" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabAudio" Content="Аудио" Style="{StaticResource PillTabButtonStyle}" Margin="6,0,0,0" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabSketch" Content="Скетч" Style="{StaticResource PillTabButtonStyle}" Margin="6,0,0,0" Checked="Tab_Checked"/>
            </StackPanel>

            <!-- 3. Tab Contents -->
            <Grid Grid.Row="2" Margin="12,4,12,4">
                <!-- Checklist View -->
                <ScrollViewer x:Name="ChecklistScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChecklistItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="6,8" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0" 
                                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}" 
                                                  VerticalAlignment="Center" 
                                                  Margin="0,0,8,0" 
                                                  Click="TaskCheck_Click"/>

                                        <!-- Title -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Title}" 
                                                   FontFamily="{StaticResource SegoeUIVariable}" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Timecode (clean subtle text) -->
                                        <Button Grid.Column="2" 
                                                Content="{Binding Timecode}" 
                                                Click="Timecode_Click" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                Foreground="{StaticResource TextSecondaryBrush}" 
                                                FontFamily="Consolas, monospace" 
                                                FontSize="11" 
                                                Cursor="Hand" 
                                                Margin="6,0" 
                                                ToolTip="Перейти к таймкоду на таймлайне"/>

                                        <!-- Pin Marker Button -->
                                        <Button Grid.Column="3" 
                                                Click="AddMarker_Click" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                Foreground="{StaticResource AccentGreenBrush}" 
                                                FontSize="11" 
                                                Cursor="Hand" 
                                                ToolTip="Поставить маркер на таймлайн DaVinci" 
                                                Content="📍"
                                                Margin="4,0"/>

                                        <!-- Delete Task Button -->
                                        <Button Grid.Column="4" 
                                                Click="DeleteTask_Click" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                Foreground="#88FFFFFF" 
                                                FontSize="10" 
                                                Cursor="Hand" 
                                                ToolTip="Удалить задачу" 
                                                Content="✕"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Notes -->
                <TextBox x:Name="NotesTextBox" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource SegoeUIVariable}" FontSize="12" TextChanged="NotesTextBox_TextChanged"/>

                <!-- Audio -->
                <views:AudioViewControl x:Name="AudioControl" Visibility="Collapsed"/>

                <!-- Sketch -->
                <views:SketchViewControl x:Name="SketchControl" Visibility="Collapsed"/>
            </Grid>

            <!-- 4. Bottom Task Input Bar -->
            <Border x:Name="BottomInputBar" Grid.Row="3" Background="#14FFFFFF" CornerRadius="0,0,10,10" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NewTaskInput" KeyDown="NewTaskInput_KeyDown" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource SegoeUIVariable}" FontSize="12" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Click="AddTaskButton_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentGreenBrush}" FontSize="16" Content="➕" Cursor="Hand" Margin="6,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
